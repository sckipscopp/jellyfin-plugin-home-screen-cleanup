<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Every package id may only come from nuget.org (no dependency confusion via other feeds). -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- signatureValidationMode is deliberately left at its default ("accept").
       "require" + trustedSigners proved brittle here: Linux CI runners have no default NuGet
       code-signing trust store, and the 2018-era analyzer packages carry signatures whose chains
       fail on some agents, which would make restores fail non-deterministically. Integrity is
       instead enforced by packages.lock.json content hashes + locked-mode restore in CI. -->
</configuration>
