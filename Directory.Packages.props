<Project>
  <!-- Central Package Management. Every version is a deliberate pin, checked to be >= 2 days old
       when added. Jellyfin.* versions define the plugin ABI: bump only together with targetAbi in
       build.yaml (Dependabot ignores them). packages.lock.json records the full resolved graph. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Jellyfin (ABI)">
    <PackageVersion Include="Jellyfin.Controller" Version="12.2.0" />
    <PackageVersion Include="Jellyfin.Model" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <PackageVersion Include="SerilogAnalyzer" Version="0.15.0" />
    <PackageVersion Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
