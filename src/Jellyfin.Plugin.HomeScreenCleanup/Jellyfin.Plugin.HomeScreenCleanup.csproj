<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable, analysis, doc generation, determinism and lock files come from
       Directory.Build.props. Package versions come from Directory.Packages.props (CPM). -->
  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.HomeScreenCleanup</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.HomeScreenCleanup</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provided by the Jellyfin server at runtime; never copied into the plugin folder. -->
    <PackageReference Include="Jellyfin.Controller">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="All" />
    <PackageReference Include="SerilogAnalyzer" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Web\client.js" />
    <EmbeddedResource Include="Web\client.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.HomeScreenCleanup.Tests" />
  </ItemGroup>

</Project>
